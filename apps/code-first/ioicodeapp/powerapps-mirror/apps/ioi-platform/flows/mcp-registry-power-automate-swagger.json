{
  "swagger": "2.0",
  "info": {
    "title": "MCP Registry",
    "description": "Power Automate custom connector definition for discovering Model Context Protocol servers from the official MCP Registry read API.",
    "version": "1.0.0"
  },
  "host": "registry.modelcontextprotocol.io",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v0.1/servers": {
      "get": {
        "operationId": "ListMcpServers",
        "summary": "List MCP servers",
        "description": "Returns registered MCP servers from the MCP Registry.",
        "x-ms-summary": "List MCP servers",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor returned in metadata.nextCursor.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Cursor"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of servers to return.",
            "required": false,
            "type": "integer",
            "format": "int32",
            "x-ms-summary": "Limit"
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search servers by name.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Search"
          },
          {
            "name": "updated_since",
            "in": "query",
            "description": "Filter servers updated since an RFC3339 timestamp.",
            "required": false,
            "type": "string",
            "format": "date-time",
            "x-ms-summary": "Updated since"
          },
          {
            "name": "version",
            "in": "query",
            "description": "Filter by version. Use latest for the latest version or provide an exact version string.",
            "required": false,
            "type": "string",
            "x-ms-summary": "Version"
          },
          {
            "name": "include_deleted",
            "in": "query",
            "description": "Include deleted servers in results.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Include deleted"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of MCP servers.",
            "schema": {
              "$ref": "#/definitions/ServerList"
            }
          }
        }
      }
    },
    "/v0.1/servers/{serverName}/versions": {
      "get": {
        "operationId": "ListMcpServerVersions",
        "summary": "List MCP server versions",
        "description": "Returns all available versions for a specific MCP server. The serverName path value must be URL-encoded.",
        "x-ms-summary": "List MCP server versions",
        "parameters": [
          {
            "name": "serverName",
            "in": "path",
            "description": "URL-encoded MCP server name, for example io.modelcontextprotocol%2Feverything.",
            "required": true,
            "type": "string",
            "x-ms-summary": "Server name"
          },
          {
            "name": "include_deleted",
            "in": "query",
            "description": "Include deleted server versions in results.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Include deleted"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of all versions for the server.",
            "schema": {
              "$ref": "#/definitions/ServerList"
            }
          },
          "404": {
            "description": "Server not found.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/v0.1/servers/{serverName}/versions/{version}": {
      "get": {
        "operationId": "GetMcpServerVersion",
        "summary": "Get MCP server version",
        "description": "Returns detailed information for a specific MCP server version. The special version latest returns the latest version.",
        "x-ms-summary": "Get MCP server version",
        "parameters": [
          {
            "name": "serverName",
            "in": "path",
            "description": "URL-encoded MCP server name, for example io.modelcontextprotocol%2Feverything.",
            "required": true,
            "type": "string",
            "x-ms-summary": "Server name"
          },
          {
            "name": "version",
            "in": "path",
            "description": "URL-encoded version to retrieve, or latest.",
            "required": true,
            "type": "string",
            "x-ms-summary": "Version"
          },
          {
            "name": "include_deleted",
            "in": "query",
            "description": "Include deleted server versions in results.",
            "required": false,
            "type": "boolean",
            "default": false,
            "x-ms-summary": "Include deleted"
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed MCP server information.",
            "schema": {
              "$ref": "#/definitions/ServerResponse"
            }
          },
          "404": {
            "description": "Server or version not found.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ServerList": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServerResponse"
          }
        },
        "metadata": {
          "$ref": "#/definitions/ListMetadata"
        }
      }
    },
    "ListMetadata": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "int32"
        },
        "nextCursor": {
          "type": "string"
        }
      }
    },
    "ServerResponse": {
      "type": "object",
      "properties": {
        "server": {
          "$ref": "#/definitions/ServerDetail"
        },
        "_meta": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "ServerDetail": {
      "type": "object",
      "required": [
        "name",
        "description",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "websiteUrl": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/definitions/Repository"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Package"
          }
        },
        "remotes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RemoteTransport"
          }
        },
        "_meta": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "Repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "Package": {
      "type": "object",
      "properties": {
        "registryType": {
          "type": "string"
        },
        "registryBaseUrl": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "fileSha256": {
          "type": "string"
        },
        "runtimeHint": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/definitions/Transport"
        },
        "runtimeArguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Argument"
          }
        },
        "packageArguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Argument"
          }
        },
        "environmentVariables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyValueInput"
          }
        }
      }
    },
    "Transport": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyValueInput"
          }
        }
      }
    },
    "RemoteTransport": {
      "allOf": [
        {
          "$ref": "#/definitions/Transport"
        }
      ]
    },
    "Argument": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "valueHint": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isRequired": {
          "type": "boolean"
        },
        "isSecret": {
          "type": "boolean"
        }
      }
    },
    "KeyValueInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isRequired": {
          "type": "boolean"
        },
        "isSecret": {
          "type": "boolean"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    }
  }
}
