{
  "formCode": "ITEVT",
  "title": "IT Event Record (⚠️ LEGACY — not rendered via DynamicForm)",
  "description": "⚠️ LEGACY REFERENCE SCHEMA. Not actively used for DynamicForm rendering. The ITE/IAL3 form uses a custom page component (pages/it/forms/ite/new.tsx). spColumn values removed — they referenced non-existent MainDB_IT columns.",
  "routeBase": "/it/forms/itevt",
  "icon": "AlertTriangle",
  "version": 1,
  "sections": [
    {
      "sectionId": "ITEVT_S2",
      "sectionName": "Section 1: Event Details",
      "displayOrder": 1,
      "fields": [
        {
          "fieldId": "EVT_Type",
          "label": "Event Type",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Outage", "Planned Maintenance", "Security Incident", "Hardware Failure", "Software Failure", "Network Issue", "Other"]
        },
        {
          "fieldId": "EVT_Desc",
          "label": "Event Description",
          "fieldType": "multiline",
          "required": true,
          "fullWidth": true,
          "displayOrder": 2,
          "placeholder": "Detailed description of the event"
        },
        {
          "fieldId": "EVT_Purpose",
          "label": "Purpose",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 3,
          "placeholder": "Purpose or objective (for planned events)"
        },
        {
          "fieldId": "EVT_Server",
          "label": "Hardware Involved",
          "fieldType": "text",
          "required": false,
          "displayOrder": 4,
          "placeholder": "Server(s) or hardware affected"
        },
        {
          "fieldId": "EVT_Att",
          "label": "Attachment",
          "fieldType": "attachment",
          "required": false,
          "fullWidth": true,
          "displayOrder": 5
        },
        {
          "fieldId": "EVT_DateFrom",
          "label": "Event Date (From)",
          "fieldType": "date",
          "required": true,
          "displayOrder": 6
        },
        {
          "fieldId": "EVT_TimeFrom",
          "label": "Event Time (From)",
          "fieldType": "time",
          "required": true,
          "displayOrder": 7
        },
        {
          "fieldId": "EVT_DateTo",
          "label": "Event Date (To)",
          "fieldType": "date",
          "required": false,
          "displayOrder": 8
        },
        {
          "fieldId": "EVT_TimeTo",
          "label": "Event Time (To)",
          "fieldType": "time",
          "required": false,
          "displayOrder": 9
        },
        {
          "fieldId": "EVT_Remarks",
          "label": "Remarks",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 10,
          "placeholder": "Additional remarks or resolution notes"
        },
        {
          "fieldId": "EVT_PreparedBy",
          "label": "Prepared By",
          "fieldType": "people",
          "required": true,
          "displayOrder": 11,
          "autoValue": "currentUser",
          "placeholder": "IT staff who logged the event"
        },
        {
          "fieldId": "EVT_PreparedDate",
          "label": "Prepared Date/Time",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "displayOrder": 12,
          "autoValue": "timestamp"
        }
      ]
    }
  ]
}
