{
  "formCode": "SVRREC",
  "title": "Server Record / RCA",
  "description": "Server incident or maintenance record with root cause analysis",
  "routeBase": "/it/forms/svrrec",
  "icon": "Server",
  "version": 1,
  "sections": [
    {
      "sectionId": "SVRREC_S2",
      "sectionName": "Section 1: Record Header",
      "displayOrder": 1,
      "fields": [
        {
          "fieldId": "HDR_Site",
          "label": "Site",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Prai", "Penang", "Johor", "Kuala Lumpur"],
          "spColumn": "siteKey",
          "spLabelToKey": {
            "Johor": "SiteKey0",
            "Penang": "SiteKey1",
            "Prai": "SiteKey2",
            "Kuala Lumpur": "SiteKey3"
          }
        },
        {
          "fieldId": "HDR_ServerName",
          "label": "Server Name",
          "fieldType": "text",
          "required": true,
          "displayOrder": 2,
          "placeholder": "e.g. PRAI-SRV-01",
          "spColumn": "serverName"
        },
        {
          "fieldId": "HDR_RecType",
          "label": "Record Type",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 3,
          "options": ["Incident", "Maintenance", "Change Request", "Problem", "Other"],
          "spColumn": "recordType"
        },
        {
          "fieldId": "HDR_Mode",
          "label": "Mode",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 4,
          "options": ["Planned", "Unplanned"],
          "spColumn": "serviceMode"
        },
        {
          "fieldId": "HDR_DateFrom",
          "label": "Date From",
          "fieldType": "date",
          "required": true,
          "displayOrder": 5,
          "spColumn": "startDate"
        },
        {
          "fieldId": "HDR_DateTo",
          "label": "Date To",
          "fieldType": "date",
          "required": true,
          "displayOrder": 6,
          "spColumn": "endDate"
        },
        {
          "fieldId": "HDR_TimeFrom",
          "label": "Time From",
          "fieldType": "time",
          "required": true,
          "displayOrder": 7,
          "spColumn": "entryTime"
        },
        {
          "fieldId": "HDR_TimeTo",
          "label": "Time To",
          "fieldType": "time",
          "required": true,
          "displayOrder": 8,
          "spColumn": "exitTime"
        }
      ]
    },
    {
      "sectionId": "SVRREC_S3",
      "sectionName": "Section 2: Analysis",
      "displayOrder": 2,
      "fields": [
        {
          "fieldId": "BODY_Summary",
          "label": "Overview / Summary",
          "fieldType": "multiline",
          "required": true,
          "fullWidth": true,
          "displayOrder": 1,
          "placeholder": "High-level summary of the event",
          "spColumn": "problemDescription"
        },
        {
          "fieldId": "BODY_Background",
          "label": "Background",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 2,
          "placeholder": "Context and background of the issue",
          "spColumn": "background"
        },
        {
          "fieldId": "BODY_Analysis",
          "label": "Analysis",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 3,
          "placeholder": "Technical analysis of the event",
          "spColumn": "analysis"
        },
        {
          "fieldId": "BODY_RootCause",
          "label": "Root Cause Description",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 4,
          "placeholder": "Identified root cause",
          "spColumn": "rootCause"
        },
        {
          "fieldId": "BODY_CA",
          "label": "Corrective Actions",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 5,
          "placeholder": "Actions taken to correct the issue",
          "spColumn": "correctiveAction"
        },
        {
          "fieldId": "BODY_PA",
          "label": "Preventive Actions",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "displayOrder": 6,
          "placeholder": "Measures to prevent recurrence",
          "spColumn": "preventiveAction"
        },
        {
          "fieldId": "BODY_Attachment",
          "label": "Attachment",
          "fieldType": "attachment",
          "required": false,
          "fullWidth": true,
          "displayOrder": 7
        }
      ]
    },
    {
      "sectionId": "SVRREC_S4",
      "sectionName": "Section 3: Personnel",
      "displayOrder": 3,
      "fields": [
        {
          "fieldId": "RBT_Required",
          "label": "Required Reboot?",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Yes", "No"],
          "notes": "⚠️ spColumn 'rebootRequired' removed — not in MainDB_IT model. Store in Remarks JSON if needed."
        },
        {
          "fieldId": "PER_PerformedBy",
          "label": "Performed By",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "placeholder": "IT Admin who created this record",
          "notes": "⚠️ spColumn 'iTName' removed — not in MainDB_IT model. Store in Remarks JSON if needed."
        }
      ]
    }
  ]
}
