{
  "formCode": "ITSSR",
  "title": "IT Support & Service Request",
  "description": "Submit an IT support or service request",
  "routeBase": "/it/forms/itssr",
  "icon": "Headset",
  "version": 1,
  "sections": [
    {
      "sectionId": "ITSSR_S2",
      "sectionName": "Section 1 — Requestor Details",
      "displayOrder": 1,
      "fields": [
        {
          "fieldId": "REQ_CaseNo",
          "label": "Case No",
          "fieldType": "text",
          "required": true,
          "readOnly": true,
          "autoValue": "generateRecordNo",
          "displayOrder": 1,
          "notes": "Auto-generated case number",
          "spColumn": "iTSSRCaseNo",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_DateCreated",
          "label": "Date Sent",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 2
        },
        {
          "fieldId": "REQ_Requestor",
          "label": "Requestor",
          "fieldType": "people",
          "required": true,
          "autoValue": "currentUser",
          "spColumn": "requestoremail",
          "displayOrder": 3,
          "notes": "Form submitter — auto-filled, can be changed"
        },
        {
          "fieldId": "REQ_ReportedBy",
          "label": "Reported By",
          "fieldType": "people",
          "required": true,
          "placeholder": "Person who experienced the issue",
          "displayOrder": 4,
          "spColumn": "iTSSRReportedByEmail",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_Company",
          "label": "Company",
          "fieldType": "text",
          "required": true,
          "placeholder": "Requestor's company",
          "displayOrder": 5,
          "spColumn": "iTSSRCompany",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_Dept",
          "label": "Department",
          "fieldType": "text",
          "required": true,
          "placeholder": "Requestor's department",
          "displayOrder": 6,
          "spColumn": "department"
        },
        {
          "fieldId": "REQ_ExtNo",
          "label": "Extension No",
          "fieldType": "text",
          "required": false,
          "placeholder": "Phone extension",
          "displayOrder": 7,
          "spColumn": "iTSSRExtNo",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_SendTo",
          "label": "To (IT Team)",
          "fieldType": "people",
          "required": true,
          "placeholder": "Assigned IT team or person",
          "displayOrder": 8,
          "spColumn": "iTSSRSendToEmail",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_CC",
          "label": "CC",
          "fieldType": "people",
          "required": false,
          "placeholder": "CC notification recipients",
          "spColumn": "cC",
          "displayOrder": 9
        },
        {
          "fieldId": "REQ_Type",
          "label": "Service Type",
          "fieldType": "choice",
          "required": true,
          "options": ["Hardware", "Software", "Network", "SAP", "Bank", "Access", "Others"],
          "displayOrder": 10,
          "spColumn": "iTSSRServiceType",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_HWare",
          "label": "Hardware Type",
          "fieldType": "choice",
          "required": false,
          "options": [
            "Desktop", "Laptop", "Printer", "Scanner", "Monitor",
            "Mouse / Keyboard", "Projector", "Server", "Network Equipment", "UPS", "Others"
          ],
          "displayOrder": 11,
          "spColumn": "iTSSRHardwareType",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_App",
          "label": "Application",
          "fieldType": "text",
          "required": false,
          "placeholder": "Application name",
          "displayOrder": 12,
          "spColumn": "iTSSRApplication",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_Module",
          "label": "Module",
          "fieldType": "text",
          "required": false,
          "placeholder": "Application module",
          "displayOrder": 13,
          "spColumn": "iTSSRModule",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_SAPModule",
          "label": "SAP Module",
          "fieldType": "choice",
          "required": false,
          "options": ["SD", "MM", "PP", "FI", "CO", "HR/HCM", "PM", "QM", "WM", "Basis", "ABAP", "Others"],
          "displayOrder": 14,
          "spColumn": "iTSSRSapModule",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_BankModule",
          "label": "Bank Module",
          "fieldType": "choice",
          "required": false,
          "options": ["CIMB BizChannel", "Maybank2E", "Public Bank", "RHB Reflex", "Ambank", "Others"],
          "displayOrder": 15,
          "spColumn": "iTSSRBankModule",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_ProblemDesc",
          "label": "Problem Description",
          "fieldType": "multiline",
          "required": true,
          "fullWidth": true,
          "placeholder": "Describe the issue in detail...",
          "displayOrder": 16,
          "spColumn": "iTSSRProblemDescription",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "REQ_Attach",
          "label": "Attachment",
          "fieldType": "attachment",
          "required": false,
          "fullWidth": true,
          "displayOrder": 17
        }
      ]
    },
    {
      "sectionId": "ITSSR_S3",
      "sectionName": "Section 2 — IT Resolution",
      "displayOrder": 2,
      "showWhen": {
        "fieldId": "__formStage__",
        "op": "in",
        "value": ["Resolution", "RequestorAcceptance", "Closure"]
      },
      "fields": [
        {
          "fieldId": "IT_Pending",
          "label": "Pending Status",
          "fieldType": "choice",
          "required": false,
          "options": [
            "Waiting for User", "Waiting for Parts", "Waiting for Vendor",
            "Waiting for Access", "Escalated", "Others"
          ],
          "displayOrder": 1,
          "spColumn": "iTSSRPendingStatus",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_Name",
          "label": "Carried Out By",
          "fieldType": "people",
          "required": true,
          "spColumn": "iTName",
          "placeholder": "IT support staff who resolved the issue",
          "displayOrder": 2
        },
        {
          "fieldId": "IT_Solution",
          "label": "Solution",
          "fieldType": "multiline",
          "required": true,
          "fullWidth": true,
          "placeholder": "Describe the resolution...",
          "displayOrder": 3,
          "spColumn": "iTSSRSolution",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_Attachment2",
          "label": "Attachment",
          "fieldType": "attachment",
          "required": false,
          "fullWidth": true,
          "displayOrder": 4
        },
        {
          "fieldId": "IT_StartDate",
          "label": "Start Date",
          "fieldType": "date",
          "required": false,
          "displayOrder": 5,
          "spColumn": "iTSSRDateStarted",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_Remarks",
          "label": "IT Remarks",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "placeholder": "Additional IT notes",
          "displayOrder": 6,
          "spColumn": "serviceRemarks"
        },
        {
          "fieldId": "IT_DateNotified",
          "label": "Date Notified",
          "fieldType": "datetime",
          "required": false,
          "displayOrder": 7,
          "spColumn": "iTSSRDateNotified",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_ProbCat1",
          "label": "Problem Category 1",
          "fieldType": "choice",
          "required": false,
          "options": [
            "Hardware Fault", "Software Error", "Network Issue", "SAP Issue",
            "Bank System Issue", "Access / Permission", "User Error", "Others"
          ],
          "displayOrder": 8,
          "spColumn": "iTSSRProblemCategory",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_ProbCat2",
          "label": "Problem Category 2",
          "fieldType": "choice",
          "required": false,
          "options": [
            "Hardware Fault", "Software Error", "Network Issue", "SAP Issue",
            "Bank System Issue", "Access / Permission", "User Error", "Others"
          ],
          "displayOrder": 9,
          "spColumn": "iTSSRProblemCategory2",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_Classification",
          "label": "Classification",
          "fieldType": "choice",
          "required": false,
          "options": ["Incident", "Service Request", "Problem", "Change Request"],
          "displayOrder": 10,
          "spColumn": "iTSSRClassification",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_Support",
          "label": "Support Method",
          "fieldType": "choice",
          "required": false,
          "options": ["Remote Desktop", "On-site", "Phone Call", "Email", "Self-Service"],
          "displayOrder": 11,
          "spColumn": "iTSSRSupportMethod",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_DateClosed",
          "label": "Date Completed",
          "fieldType": "datetime",
          "required": true,
          "displayOrder": 12,
          "spColumn": "iTSSRDateResolved",
          "spTable": "ExtSupport"
        }
      ]
    },
    {
      "sectionId": "ITSSR_S4",
      "sectionName": "Section 3 — Requestor Acceptance",
      "displayOrder": 3,
      "showWhen": {
        "fieldId": "__formStage__",
        "op": "in",
        "value": ["RequestorAcceptance", "Closure"]
      },
      "fields": [
        {
          "fieldId": "ACC_DateAccept",
          "label": "Date Accepted",
          "fieldType": "datetime",
          "required": true,
          "displayOrder": 1,
          "spColumn": "iTSSRDateAccepted",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "ACC_Comment",
          "label": "Comment",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "placeholder": "Acceptance notes",
          "displayOrder": 2,
          "spColumn": "iTSSRAcceptanceComment",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "ACC_RatingCom",
          "label": "Rating (1–10)",
          "fieldType": "text",
          "required": true,
          "placeholder": "1 = Poor, 10 = Excellent",
          "displayOrder": 3,
          "spColumn": "iTSSRSatisfactionRating",
          "spTable": "ExtSupport",
          "spColumnType": "number"
        }
      ]
    },
    {
      "sectionId": "ITSSR_S5",
      "sectionName": "Section 4 — IT Final Comments",
      "displayOrder": 4,
      "showWhen": {
        "fieldId": "__formStage__",
        "op": "eq",
        "value": "Closure"
      },
      "fields": [
        {
          "fieldId": "IT_FinalRemark",
          "label": "IT Final Remark",
          "fieldType": "multiline",
          "required": false,
          "fullWidth": true,
          "placeholder": "Final closure notes",
          "displayOrder": 1,
          "spColumn": "iTSSRFinalRemark",
          "spTable": "ExtSupport"
        },
        {
          "fieldId": "IT_FinalNotify",
          "label": "Date Notify",
          "fieldType": "datetime",
          "required": false,
          "displayOrder": 2,
          "spColumn": "iTSSRFinalNotifyDate",
          "spTable": "ExtSupport"
        }
      ]
    }
  ]
}
