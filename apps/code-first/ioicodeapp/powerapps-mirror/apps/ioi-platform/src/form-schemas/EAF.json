{
  "formCode": "EAF",
  "title": "External Access Form (VPN & Citrix)",
  "description": "5-stage approval workflow for VPN/Citrix external access requests",
  "routeBase": "/it/forms/eaf",
  "icon": "Globe",
  "version": 2,
  "sections": [
    {
      "sectionId": "EAF_S1",
      "sectionName": "Section 1: Requestor",
      "displayOrder": 1,
      "fields": [
        {
          "fieldId": "REQ_Company",
          "label": "Company",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "spColumn": "company",
          "spTable": "MainDB_IT",
          "notes": "Requestor's company — maps to Domino 'Company' field"
        },
        {
          "fieldId": "REQ_Requestor",
          "label": "Requestor",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "spColumn": "requestoremail",
          "spTable": "MainDB_IT",
          "notes": "Person submitting — maps to Domino 'RequestedBy' / 'req' field"
        },
        {
          "fieldId": "REQ_DateSubmitted",
          "label": "Date Submitted",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 3,
          "spColumn": "submitteddate",
          "spTable": "MainDB_IT",
          "notes": "Auto-populated on submit — maps to Domino 'date1'"
        },
        {
          "fieldId": "REQ_User",
          "label": "Target User",
          "fieldType": "people",
          "required": true,
          "displayOrder": 4,
          "spColumn": "eAFTargetUserEmail",
          "spTable": "ExtAccess",
          "notes": "User who will receive VPN/external access — maps to Domino 'User' field"
        },
        {
          "fieldId": "REQ_App",
          "label": "Application",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 5,
          "options": ["VPN", "Citrix", "Remote Desktop", "File Share", "SAP", "Other"],
          "spColumn": "eAFApplication",
          "spTable": "ExtAccess",
          "notes": "Access type — maps to Domino 'AgentName' / Type field"
        },
        {
          "fieldId": "REQ_System",
          "label": "System",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 6,
          "spColumn": "eAFSystemName",
          "spTable": "ExtAccess",
          "notes": "System name or environment — maps to Domino 'system' field"
        },
        {
          "fieldId": "REQ_ClientID",
          "label": "Client ID",
          "fieldType": "text",
          "required": true,
          "displayOrder": 7,
          "spColumn": "eAFClientID",
          "spTable": "ExtAccess",
          "notes": "Client identifier — maps to Domino 'ClientID' field (NEW)"
        },
        {
          "fieldId": "REQ_Group",
          "label": "User Group",
          "fieldType": "text",
          "required": false,
          "displayOrder": 8,
          "spColumn": "eAFUserGroup",
          "spTable": "ExtAccess",
          "notes": "User group for access — maps to Domino 'Group' field (NEW)"
        },
        {
          "fieldId": "REQ_Justification",
          "label": "Justification",
          "fieldType": "multiline",
          "required": true,
          "displayOrder": 9,
          "spColumn": "remarks",
          "spTable": "MainDB_IT",
          "notes": "Business reason for external access — maps to Domino 'justification' field"
        },
        {
          "fieldId": "REQ_DeptHead",
          "label": "Dept Head",
          "fieldType": "people",
          "required": true,
          "displayOrder": 10,
          "spColumn": "eAFDeptHeadEmail",
          "spTable": "ExtAccess",
          "notes": "Requestor's Head of Department — maps to Domino 'depthead' field"
        },
        {
          "fieldId": "REQ_HApp",
          "label": "Higher Approver (COO/Director)",
          "fieldType": "people",
          "required": false,
          "displayOrder": 11,
          "spColumn": "eAFHigherApproverEmail",
          "spTable": "ExtAccess",
          "notes": "COO (if PanCen) or Division Director — maps to Domino 'HApp' field"
        },
        {
          "fieldId": "REQ_CC",
          "label": "CC",
          "fieldType": "people",
          "required": false,
          "displayOrder": 12,
          "spColumn": "cC",
          "spTable": "MainDB_IT",
          "notes": "CC notification recipients — maps to Domino 'CC' field"
        }
      ]
    },
    {
      "sectionId": "EAF_S2",
      "sectionName": "Section 2: HOD Acceptance (Stage 2)",
      "displayOrder": 2,
      "fields": [
        {
          "fieldId": "HOD_Status",
          "label": "Status",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Approved", "Rejected", "Pending"],
          "spColumn": "eAFStatus1",
          "spTable": "ExtAccess",
          "notes": "Maps to Domino 'status1' — Approved/Rejected/Pending"
        },
        {
          "fieldId": "HOD_Name",
          "label": "HOD Name",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "spColumn": "eAFHODName",
          "spTable": "ExtAccess",
          "notes": "HOD who acted — maps to Domino 'HODNAME'"
        },
        {
          "fieldId": "HOD_Date",
          "label": "Date",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 3,
          "spColumn": "eAFDate2",
          "spTable": "ExtAccess",
          "notes": "Auto on action — maps to Domino 'date2'"
        },
        {
          "fieldId": "HOD_Comment",
          "label": "Comment",
          "fieldType": "multiline",
          "required": false,
          "displayOrder": 4,
          "spColumn": "eAFComment1",
          "spTable": "ExtAccess",
          "notes": "HOD notes — maps to Domino 'comment1'"
        }
      ]
    },
    {
      "sectionId": "EAF_S3",
      "sectionName": "Section 3: Division Director / COO Acceptance (Stage 3)",
      "displayOrder": 3,
      "fields": [
        {
          "fieldId": "DIV_Status",
          "label": "Status",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Approved", "Rejected", "Pending"],
          "spColumn": "eAFStatus2",
          "spTable": "ExtAccess",
          "notes": "Maps to Domino 'status2'"
        },
        {
          "fieldId": "DIV_Name",
          "label": "Division Director / COO Name",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "spColumn": "eAFDIVName",
          "spTable": "ExtAccess",
          "notes": "Division Director who acted — maps to Domino 'DIVNAME'"
        },
        {
          "fieldId": "DIV_Date",
          "label": "Date",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 3,
          "spColumn": "eAFDate3",
          "spTable": "ExtAccess",
          "notes": "Auto on action — maps to Domino 'date3'"
        },
        {
          "fieldId": "DIV_Comment",
          "label": "Comment",
          "fieldType": "multiline",
          "required": false,
          "displayOrder": 4,
          "spColumn": "eAFComment2",
          "spTable": "ExtAccess",
          "notes": "Division Director notes — maps to Domino 'comment2'"
        }
      ]
    },
    {
      "sectionId": "EAF_S4",
      "sectionName": "Section 4: IT Manager Acceptance (Stage 4)",
      "displayOrder": 4,
      "fields": [
        {
          "fieldId": "ITMGR_Status",
          "label": "Status",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Approved", "Rejected", "Pending"],
          "spColumn": "eAFStatus3",
          "spTable": "ExtAccess",
          "notes": "Maps to Domino 'status3'"
        },
        {
          "fieldId": "ITMGR_Name",
          "label": "IT Manager Name",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "spColumn": "eAFName4",
          "spTable": "ExtAccess",
          "notes": "IT Manager who acted — maps to Domino 'name4'"
        },
        {
          "fieldId": "ITMGR_Date",
          "label": "Date",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 3,
          "spColumn": "eAFDate4",
          "spTable": "ExtAccess",
          "notes": "Auto on action — maps to Domino 'date4'"
        },
        {
          "fieldId": "ITMGR_Comment",
          "label": "Comment",
          "fieldType": "multiline",
          "required": false,
          "displayOrder": 4,
          "spColumn": "eAFComment3",
          "spTable": "ExtAccess",
          "notes": "IT Manager notes — maps to Domino 'comment3'"
        }
      ]
    },
    {
      "sectionId": "EAF_S5",
      "sectionName": "Section 5: IT Provisioning (Stage 5)",
      "displayOrder": 5,
      "fields": [
        {
          "fieldId": "IT_Status",
          "label": "Status",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Completed", "Rejected", "Pending"],
          "spColumn": "eAFStatus4",
          "spTable": "ExtAccess",
          "notes": "Maps to Domino 'status4'"
        },
        {
          "fieldId": "IT_Name",
          "label": "IT Staff Name",
          "fieldType": "people",
          "required": true,
          "displayOrder": 2,
          "spColumn": "eAFName5",
          "spTable": "ExtAccess",
          "notes": "IT staff who completed — maps to Domino 'name5'"
        },
        {
          "fieldId": "IT_Date",
          "label": "Date",
          "fieldType": "datetime",
          "required": true,
          "readOnly": true,
          "autoValue": "timestamp",
          "displayOrder": 3,
          "spColumn": "eAFDate5",
          "spTable": "ExtAccess",
          "notes": "Auto on action — maps to Domino 'date5'"
        },
        {
          "fieldId": "IT_Comment",
          "label": "Comment",
          "fieldType": "multiline",
          "required": false,
          "displayOrder": 4,
          "spColumn": "eAFComment4",
          "spTable": "ExtAccess",
          "notes": "IT provisioning notes — maps to Domino 'comment4'"
        }
      ]
    },
    {
      "sectionId": "EAF_S6",
      "sectionName": "Section 6: For IT Use (Configuration)",
      "displayOrder": 6,
      "fields": [
        {
          "fieldId": "ITCFG_Attachment",
          "label": "Attachment",
          "fieldType": "attachment",
          "required": false,
          "displayOrder": 1,
          "notes": "Configuration documentation"
        },
        {
          "fieldId": "ITCFG_Remarks",
          "label": "Remarks",
          "fieldType": "multiline",
          "required": false,
          "displayOrder": 2,
          "notes": "Configuration notes"
        },
        {
          "fieldId": "ITCFG_Status",
          "label": "Status",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 3,
          "options": ["Configured", "Denied"],
          "notes": "Configured / Denied"
        }
      ]
    }
  ]
}
