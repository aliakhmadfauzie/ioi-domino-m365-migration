{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "IOI: Start Vite Dev Server",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/apps/code-first/ioicodeapp/powerapps-mirror/apps/ioi-platform"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "IOI Platform"
            }
        },
        {
            "label": "IOI: Typecheck",
            "type": "shell",
            "command": "npx tsc --noEmit",
            "options": {
                "cwd": "${workspaceFolder}/apps/code-first/ioicodeapp/powerapps-mirror/apps/ioi-platform"
            },
            "group": "build",
            "problemMatcher": ["$tsc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "IOI Platform"
            }
        },
        {
            "label": "IOI: Build",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/apps/code-first/ioicodeapp/powerapps-mirror/apps/ioi-platform"
            },
            "group": "build",
            "problemMatcher": ["$tsc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "IOI Platform"
            }
        },
        {
            "label": "IOI: Lint",
            "type": "shell",
            "command": "npm run lint",
            "options": {
                "cwd": "${workspaceFolder}/apps/code-first/ioicodeapp/powerapps-mirror/apps/ioi-platform"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "IOI Platform"
            }
        },
        {
            "label": "PAC: Auth List",
            "type": "shell",
            "command": "pac auth list",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "PAC: Who Am I",
            "type": "shell",
            "command": "pac who",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "PAC: List Environments",
            "type": "shell",
            "command": "pac org list",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "PAC: Pull Solution",
            "type": "shell",
            "command": "pac solution clone --name ${input:solutionName} --outputDirectory ./source",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Git: Current Branch",
            "type": "shell",
            "command": "git branch --show-current",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Git: Status",
            "type": "shell",
            "command": "git status",
            "group": "none",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "solutionName",
            "description": "Power Platform Solution Name",
            "type": "promptString",
            "default": ""
        }
    ]
}
