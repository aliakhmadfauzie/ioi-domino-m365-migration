{
  "formCode": "SVRREBOOT",
  "title": "Server Reboot Log (⚠️ LEGACY — not rendered via DynamicForm)",
  "description": "⚠️ LEGACY REFERENCE SCHEMA. Not actively used for DynamicForm rendering. The SRL/IAL1 form uses a custom page component (pages/it/forms/srl/new.tsx). spColumn values removed — they referenced non-existent MainDB_IT columns.",
  "routeBase": "/it/forms/svrreboot",
