{
  "formCode": "DCALOG",
  "title": "Data Center Access Log",
  "description": "Log entry for physical access to the data center / server room",
  "routeBase": "/it/forms/dcalog",
  "icon": "ServerCog",
  "version": 1,
  "sections": [
    {
      "sectionId": "DCALOG_S2",
      "sectionName": "Section 1: Access Event Details",
      "displayOrder": 1,
      "fields": [
        {
          "fieldId": "ACC_Site",
          "label": "Site",
          "fieldType": "choice",
          "required": true,
          "displayOrder": 1,
          "options": ["Prai", "Penang", "Johor", "Kuala Lumpur"],
          "spColumn": "Site",
          "notes": "Site location"
        },
        {
          "fieldId": "ACC_ServerRoom",
          "label": "Server Room",
          "fieldType": "text",
          "required": true,
          "displayOrder": 2,
          "placeholder": "e.g. Main Server Room, Network Room",
          "notes": "Specific room or area accessed"
        },
        {
          "fieldId": "ACC_Date",
          "label": "Date",
          "fieldType": "date",
          "required": true,
          "displayOrder": 3,
          "spColumn": "StartDate",
          "notes": "Date of access"
        },
        {
          "fieldId": "ACC_TimeIn",
          "label": "Time In",
          "fieldType": "time",
          "required": true,
          "displayOrder": 4,
          "spColumn": "EntryTime",
          "notes": "Entry time"
        },
        {
          "fieldId": "ACC_Visitor",
          "label": "Visitor Name",
          "fieldType": "text",
          "required": true,
          "displayOrder": 5,
          "placeholder": "Full name of visitor",
          "spColumn": "VisitorName"
        },
        {
          "fieldId": "ACC_Company",
          "label": "Company / Department",
          "fieldType": "text",
          "required": true,
          "displayOrder": 6,
          "placeholder": "Visitor's company or internal department",
          "spColumn": "VisitorCompany"
        },
        {
          "fieldId": "ACC_Reason",
          "label": "Reason for Access",
          "fieldType": "multiline",
          "required": true,
          "fullWidth": true,
          "displayOrder": 7,
          "placeholder": "Purpose of visit",
          "spColumn": "PurposeOfVisit"
        },
        {
          "fieldId": "ACC_AttendedBy",
          "label": "Attended By (PIC)",
          "fieldType": "people",
          "required": true,
          "displayOrder": 8,
          "placeholder": "IT staff who accompanied the visitor",
          "spColumn": "EscortedBy",
          "notes": "IT staff person-in-charge who escorted the visitor"
        }
      ]
    }
  ]
}
